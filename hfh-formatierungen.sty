\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hfh-formatierungen}
  [2026/07/31 v1.0 Formatierungen der HFH-LaTeX-Vorlage]

% ---------------------------------------------------------------------------
% Sprache, Schriften und Seitenlayout
% ---------------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[english,ngerman]{babel} % B.4
\RequirePackage{newtxtext,newtxmath} % C.1
\RequirePackage{xcolor}
\RequirePackage{etoolbox}

\RequirePackage[
  a4paper, % A.1
  portrait, % A.1
  left=3cm, % A.3
  right=4cm, % A.3
  top=2.5cm, % A.3
  bottom=2.5cm % A.3
]{geometry}

\RequirePackage{setspace}
\setstretch{1.43} % B.1: entspricht 1,5 Zeilen der Word-Vorlage.
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt} % B.3

% Deutsch ist voreingestellt. Babel stellt auch englische Trennung und
% Bezeichnungen bereit.
\AtBeginDocument{\selectlanguage{\MainLanguage}}
\newcommand{\DEEN}[2]{\iflanguage{english}{#2}{#1}}

% Standardmaessig werden drei Ebenen nummeriert: 1, 1.1 und 1.1.1. Fuer eine
% umfangreiche Arbeit beide Werte auf 3 setzen, um Ebene vier zu aktivieren.
\setcounter{secnumdepth}{2} % J.6
\setcounter{tocdepth}{2} % J.6

% Hauptueberschriften sind 14 pt gross, tiefere Ebenen 12 pt und fett.
\setkomafont{disposition}{\normalfont\bfseries\setstretch{1}} % C.2-C.3
\setkomafont{chapter}{\fontsize{14}{17}\selectfont} % C.2
\setkomafont{section}{\fontsize{12}{14.5}\selectfont} % C.3
\setkomafont{subsection}{\fontsize{12}{14.5}\selectfont} % C.3
\setkomafont{subsubsection}{\fontsize{12}{14.5}\selectfont} % C.3
\RedeclareSectionCommand[beforeskip=0pt,afterskip=18pt]{chapter}
\RedeclareSectionCommand[beforeskip=18pt,afterskip=12pt]{section}
\RedeclareSectionCommand[beforeskip=18pt,afterskip=12pt]{subsection}
\RedeclareSectionCommand[beforeskip=18pt,afterskip=12pt]{subsubsection}

% ---------------------------------------------------------------------------
% Kopfzeile, Fusszeile, Fussnoten, Gleitumgebungen und Quellen
% ---------------------------------------------------------------------------
\RequirePackage[automark,singlespacing=true]{scrlayer-scrpage} % D.1
\clearpairofpagestyles
\ihead{\AuthorName} % D.2
\ohead{\MatriculationNumber} % D.2
\ofoot{}
\AtBeginDocument{%
  \ifdefstring{\MainLanguage}{english}
    {\ofoot{Page \thepage\ of \pageref*{LastNumberedPage}}}
    {\ofoot{Seite \thepage\ von \pageref*{LastNumberedPage}}}}
\setkomafont{pageheadfoot}{%
  \normalfont\fontsize{10}{12}\selectfont} % D.1
\setlength{\headheight}{15pt}
\pagestyle{scrheadings}
\renewcommand*{\chapterpagestyle}{scrheadings}

\counterwithout{footnote}{chapter} % E.5
\setlength{\footnotesep}{14pt} % E.3-E.4
\newcommand*{\HFHFootnoteMark}{%
  \raisebox{0.7ex}{\fontsize{9}{9}\selectfont\thefootnotemark}} % E.1
\deffootnotemark{\HFHFootnoteMark} % E.1
\deffootnote[0.5cm]{0.5cm}{0cm}{%
  \raggedright\makebox[0.5cm][l]{\HFHFootnoteMark}} % E.1-E.2

\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{caption}
\captionsetup{
  format=plain,
  justification=justified,
  singlelinecheck=false,
  font={footnotesize,it}, % F.2, G.2
  labelfont={bf,it},
  labelsep=colon,
  skip=6pt % F.3, G.3
}
\counterwithout{figure}{chapter} % G.1
\counterwithout{table}{chapter} % F.1
\setlength{\intextsep}{12pt} % G.4
\setlength{\textfloatsep}{12pt} % G.4
\numberwithin{equation}{chapter} % H.1

% Diese Umgebungen setzen Inhalte in empfohlenen 10 pt und einzeilig.
\newenvironment{hfhtable}[1][htbp]
  {\begin{table}[#1]\centering\footnotesize\setstretch{1}} % F.5-F.6
  {\end{table}}
\newenvironment{hfhfigure}[1][htbp]
  {\begin{figure}[#1]\centering\footnotesize\setstretch{1}} % G.6-G.7
  {\end{figure}}
\newcommand{\HFHSourceLine}[2]{%
  \par\vspace{3pt}\begingroup
    \footnotesize\itshape\setstretch{1}#1%
    \DEEN{Quelle}{Source}: #2\par
  \endgroup} % F.1, G.1
% Tabelle 1 legt keine Ausrichtung fest; linksbündig ist der Standard
\newcommand{\source}[1]{\HFHSourceLine{\raggedright}{#1}}
\newcommand{\sourcecentered}[1]{\HFHSourceLine{\centering}{#1}}
\newcommand{\sourceindented}[2][1.75cm]{%
  \HFHSourceLine{\raggedright\leftskip=#1\relax}{#2}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

\RequirePackage{xurl}
\RequirePackage{csquotes}
\RequirePackage[
  backend=biber,
  style=authoryear,
  sorting=nyt,
  sortlocale=de_DE,
  giveninits=false,
  maxbibnames=99,
  dashed=false,
  doi=false,
  eprint=false,
  isbn=false
]{biblatex}
\DeclareNameAlias{sortname}{family-given}
\setlength{\bibhang}{0.5cm} % I.3
\setlength{\bibitemsep}{6pt} % I.2
\setlength{\bibparsep}{0pt}
\AtBeginBibliography{% I.1
  \singlespacing
  \setlength{\parskip}{0pt}}

% Fuer Rechts- und Verwaltungsquellen dieselben Abstaende verwenden.
\newenvironment{hfhsourceentries}
  {\par\begingroup\singlespacing\setlength{\parskip}{6pt}} % I.1-I.2
  {\par\endgroup}
\newcommand{\hfhsourceentry}[1]{%
  \par\noindent\hangindent=0.5cm\hangafter=1 #1\par} % I.3

\RequirePackage[hidelinks]{hyperref}
\RequirePackage{bookmark}
\RequirePackage{pdfpages}
\hypersetup{
  pdftitle={\ThesisTitle},
  pdfauthor={\AuthorName},
  pdfsubject={\ThesisType}
}

\newcommand{\TemplateHint}[1]{%
  \par\begingroup\small\itshape\color{gray}#1\par\endgroup}

% Das Titelblatt ist Seite 1, zeigt aber keine Seitenzahl. Bei einer
% anmeldepflichtigen Arbeit ist es durch das offizielle Titelblatt des
% Pruefungsamts zu ersetzen. Der alternative Befehl nimmt eine einseitige PDF.
\newcommand{\MakeThesisTitle}{% J.1-J.2
  \setcounter{page}{1}
  \thispagestyle{empty}
  \begin{center}
    \vspace*{1.2cm}
    {\large Hamburger Fern-Hochschule\par}
    \vspace{0.3cm}
    {\Department\par}

    \vfill
    {\large\ThesisType\par}
    \vspace{1.2cm}
    {\bfseries\fontsize{20}{24}\selectfont\ThesisTitle\par}
    \vspace{0.5cm}
    {\large\ThesisSubtitle\par}
    \vfill

    \begin{tabular}{@{}ll@{}}
      \DEEN{Verfasser/in}{Author}: & \AuthorName \\
      \DEEN{Matrikelnummer}{Student ID}: & \MatriculationNumber \\
      \DEEN{Studiengang}{Degree programme}: & \DegreeProgramme \\
      \DEEN{Erstprüfer/in}{First examiner}: & \FirstExaminer \\
      \DEEN{Zweitprüfer/in}{Second examiner}: & \SecondExaminer \\
      \DEEN{Abgabedatum}{Submission date}: & \SubmissionDate
    \end{tabular}
  \end{center}
  \clearpage
}

\newcommand{\MakeOfficialTitlePage}[1]{% J.1-J.2
  \includepdf[pages=1,pagecommand={\thispagestyle{empty}}]{#1}
  \setcounter{page}{2}
}

% Die HFH-Vorlage fuehrt das Inhaltsverzeichnis in sich selbst auf. Dieser
\makeatletter
\newcommand{\ThesisTableOfContents}{%
  \chapter*{\contentsname}
  \phantomsection
  \addcontentsline{toc}{chapter}{\contentsname}
  \@starttoc{toc}
}
\makeatother

\endinput
